# ── LLM Provider API Keys ──────────────────────────────────────────────────
# Provide at least one key. If multiple are set, the app will automatically
# fall back to the next provider if the primary one hits a rate limit.
# Priority order: Groq → Google Gemini → Anthropic → OpenAI

# Primary (fastest inference)
GROQ_API_KEY=

# Fallback providers (optional — add any or all for automatic failover)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model (used for Groq primary)
MODEL_NAME=llama-3.3-70b-versatile

# Chunking
MAX_CHUNK_SIZE=4000
CHUNK_OVERLAP=500

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO